{
  "name": "skjson-page",
  "private": true,
  "workspaces": [
    "./apps/*"
  ],
  "scripts": {
    "vercel:install": "npm install",
    "web": "npm run build && npm run dev --workspace=next-app",
    "web:prod": "npm run build --workspace=next-app",
    "web:prod:serve": "npm run serve --workspace=next-app",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "resolutions": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "dependencies": {
    "husky": "^9.1.6",
    "turbo": "^1.13.4",
    "typescript": "~5.8.3",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": "22",
    "npm": "10.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3"
  }
}
