{
  "name": "skjson-page",
  "private": true,
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "scripts": {
    "native": "npm run start --workspace=expo",
    "native:prebuild": "npm run prebuild --workspace=expo",
    "ios": "npm run ios --workspace=expo",
    "android": "npm run android --workspace=expo",
    "watch": "ultra -r --no-pretty --concurrency 400 watch",
    "vercel:install": "npm install",
    "web": "npm run build && npm run dev --workspace=next-app",
    "web:extract": "DISABLE_EXTRACTION=false npm run dev --workspace=next-app",
    "web:prod": "npm run build --workspace=next-app",
    "web:prod:serve": "npm run serve --workspace=next-app",
    "postinstall": "npm run check-tamagui && npm run build",
    "build": "npm run build --workspaces --if-present",
    "upgrade:tamagui": "npm update '*tamagui*' '@tamagui/*'",
    "upgrade:tamagui:canary": "npm update '*tamagui*' '@tamagui/*'",
    "check-tamagui": "tamagui check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "resolutions": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-refresh": "^0.14.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.2",
    "@tamagui/core": "2.0.0-rc.16",
    "@tamagui/web": "2.0.0-rc.16",
    "tamagui": "2.0.0-rc.16",
    "@react-navigation/native": "7.1.28"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.6",
    "@tamagui/cli": "2.0.0-rc.16",
    "@tamagui/react-native-svg": "2.0.0-rc.16",
    "@tamagui/react-native-web-lite": "2.0.0-rc.16",
    "check-dependency-version-consistency": "^4.1.0",
    "expo": "^54",
    "husky": "^9.1.6",
    "turbo": "^1.13.4",
    "typescript": "~5.8.3",
    "ultra-runner": "^3.10.5",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": "22",
    "npm": "10.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3"
  }
}
